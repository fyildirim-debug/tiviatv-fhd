<skin>
	<!-- TiviATV FHD  -  active typeface set
	     Written by the "TiviATV Font" plugin; can also be edited by hand.
	     skin.xml loads it with <include>; the font names never change. -->
	<fonts>
		<!-- Inter -->
		<font filename="Inter-Regular.ttf" name="TM" scale="92" />
		<font filename="Inter-Medium.ttf" name="TMM" scale="92" />
		<font filename="Inter-SemiBold.ttf" name="TMB" scale="92" />
		<font filename="Inter-Bold.ttf" name="TMX" scale="92" />
		<!-- font that comes with the box (VFD and fallback) -->
		<font filename="nmsbd.ttf"  name="Regular" scale="100" />
		<!-- aliases enigma2 expects -->
		<alias name="Body"       font="TM"  size="30" height="40" />
		<alias name="TextNormal" font="TM"  size="30" height="40" />
		<alias name="ChoiceList" font="TM"  size="30" height="60" />
		<alias name="VirtualKeyboard" font="TM" size="34" height="76" />
	</fonts>
</skin>
